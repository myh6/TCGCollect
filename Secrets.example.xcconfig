// Template for Secrets.xcconfig, which is git-ignored and holds the real values.
// Copy this file to Secrets.xcconfig in the same folder and fill in your values.
//
// xcconfig treats "//" as a comment, so write URLs as http:/$()/host:port.

BACKEND_BASE_URL = http:/$()/192.168.1.113:8000
BACKEND_API_KEY = your-api-key-here
