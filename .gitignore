# macOS
.DS_Store

# Xcode per-user state (breakpoints, scheme order, UI layout)
xcuserdata/
*.xcuserstate

# Build output
DerivedData/
build/
.build/
*.xcresult

# Claude Code local settings and state
.claude/

# Secrets: API keys and local config never go in git
.env
*.secrets.xcconfig
Secrets.xcconfig

# fastlane output (test results go to build/)
fastlane/report.xml
fastlane/test_output/

# Bundler: gems install into vendor/bundle; .bundle/config is per machine
vendor/bundle/
.bundle/
