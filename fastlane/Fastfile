require "rexml/document"

default_platform(:ios)

platform :ios do
  after_all do |lane|
    notify_slack(lane, success: true)
  end

  error do |lane, exception|
    notify_slack(lane, success: false, details: exception.message.gsub(/\e\[[\d;]*m/, ""))
  end

  desc "Runs every unit test: the AppCore and HoloCard packages' and the app's TCGCollectTests on an iOS Simulator"
  desc "Set SIMULATOR_ID=<udid> to pick a simulator; otherwise fastlane picks an available iPhone"
  lane :ci do
    FileUtils.rm_rf(test_results_directory)
    use_placeholder_secrets_if_missing
    test_package("AppCore")
    test_package("HoloCard")
    run_tests(
      project: "TCGCollect.xcodeproj",
      scheme: "TCGCollect",
      only_testing: ["TCGCollectTests"],
      destination: simulator_destination,
      derived_data_path: "build/DerivedData",
      output_directory: "build/test-results",
      output_types: "junit",
      output_files: "TCGCollect.xml",
      result_bundle: true,
      skip_slack: true,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
    lane_context[:SLACK_DETAILS] = test_summary
  end

  desc "Builds an unsigned Release app for the iOS Simulator and zips it into build/artifacts"
  desc "Install it with: unzip the file, then xcrun simctl install booted TCGCollect.app"
  lane :build do
    build_app(
      project: "TCGCollect.xcodeproj",
      scheme: "TCGCollect",
      configuration: "Release",
      destination: "generic/platform=iOS Simulator",
      derived_data_path: "build/DerivedData",
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )

    app = File.expand_path("../build/DerivedData/Build/Products/Release-iphonesimulator/TCGCollect.app", __dir__)
    version = info_plist_value(app, "CFBundleShortVersionString")
    build_number = info_plist_value(app, "CFBundleVersion")
    artifacts = File.expand_path("../build/artifacts", __dir__)
    FileUtils.mkdir_p(artifacts)
    zip_path = File.join(artifacts, "TCGCollect-#{version}-#{build_number}-simulator.zip")
    sh("ditto", "-c", "-k", "--keepParent", app, zip_path)
    UI.success("Simulator app: #{zip_path}")
    lane_context[:SLACK_DETAILS] = File.basename(zip_path)
    zip_path
  end
end

# The app's Debug build reads Secrets.xcconfig. CI has none, so use the template's placeholder values.
# Never overwrite a real local one.
def use_placeholder_secrets_if_missing
  secrets = File.expand_path("../Secrets.xcconfig", __dir__)
  return if File.exist?(secrets)

  UI.important("Secrets.xcconfig not found; using Secrets.example.xcconfig placeholders")
  FileUtils.cp(File.expand_path("../Secrets.example.xcconfig", __dir__), secrets)
end

# The end-to-end tests skip themselves because E2E_BASE_URL and E2E_API_KEY aren't set here.
# Swift Testing writes its JUnit report next to the given path, as <name>-swift-testing.xml.
def test_package(name)
  FileUtils.mkdir_p(test_results_directory)
  sh(
    "swift", "test",
    "--package-path", File.expand_path("../Packages/#{name}", __dir__),
    "--xunit-output", File.join(test_results_directory, "#{name}.xml")
  )
end

def test_results_directory
  File.expand_path("../build/test-results", __dir__)
end

def test_summary
  counts = Hash.new(0)
  Dir[File.join(test_results_directory, "*.xml")].each do |file|
    REXML::XPath.each(REXML::Document.new(File.read(file)), "//testcase") do |testcase|
      if testcase.elements["failure"] || testcase.elements["error"]
        counts[:failed] += 1
      elsif testcase.elements["skipped"]
        counts[:skipped] += 1
      else
        counts[:passed] += 1
      end
    end
  end
  "#{counts.values.sum} tests: #{counts[:passed]} passed, #{counts[:failed]} failed, #{counts[:skipped]} skipped"
end

# Posts only when SLACK_URL is set, as CI does, so local runs stay quiet. A Slack outage never fails the lane.
def notify_slack(lane, success:, details: nil)
  return UI.message("SLACK_URL not set; skipping Slack") if ENV["SLACK_URL"].to_s.empty?

  fields = {
    "Details" => (details || lane_context[:SLACK_DETAILS]).to_s[0, 500],
    "Branch" => ENV["GIT_BRANCH"],
    "Pull request" => ENV["PR_URL"],
    "Run" => github_run_url
  }.reject { |_, value| value.to_s.empty? }

  slack(
    message: success ? "✅ TCGCollect `#{lane}` passed" : "❌ TCGCollect `#{lane}` failed",
    success: success,
    slack_url: ENV["SLACK_URL"],
    default_payloads: [],
    payload: fields,
    fail_on_error: false
  )
rescue StandardError => e
  UI.error("Couldn't post to Slack: #{e.message}")
end

def github_run_url
  return nil if ENV["GITHUB_RUN_ID"].to_s.empty?

  "#{ENV['GITHUB_SERVER_URL']}/#{ENV['GITHUB_REPOSITORY']}/actions/runs/#{ENV['GITHUB_RUN_ID']}"
end

def info_plist_value(app, key)
  sh("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", File.join(app, "Info.plist"), log: false).strip
end

def simulator_destination
  id = ENV["SIMULATOR_ID"]
  id.to_s.empty? ? nil : "platform=iOS Simulator,id=#{id}"
end
